{
  "name": "motiongames",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "node scripts/setup-mediapipe.mjs",
    "fixtures:synthetic": "WRITE_FIXTURES=1 vitest run tests/generateFixtures.test.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
